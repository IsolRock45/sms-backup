<?xml version="1.0" encoding="utf-8"?>
<!-- Disable auto backup of the SMS database. Backups belong on your private
     server, not in Google's cloud. -->
<full-backup-content>
    <exclude domain="database" path="sms_backup.db" />
    <exclude domain="database" path="sms_backup.db-journal" />
</full-backup-content>
