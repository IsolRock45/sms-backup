<?xml version="1.0" encoding="utf-8"?>
<!-- Same rationale as the sms-backup module: keep the captured notifications
     on-device. Room 2.6+ runs in WAL mode, so we exclude the .db plus its
     WAL/SHM sidecars (NOT a non-existent .db-journal). -->
<full-backup-content>
    <exclude domain="database" path="tracker.db" />
    <exclude domain="database" path="tracker.db-wal" />
    <exclude domain="database" path="tracker.db-shm" />
</full-backup-content>
