<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replacement for full-backup-content. <device-transfer> is
     *not* covered by android:allowBackup="false", so it must be listed too. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="tracker.db" />
        <exclude domain="database" path="tracker.db-wal" />
        <exclude domain="database" path="tracker.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="tracker.db" />
        <exclude domain="database" path="tracker.db-wal" />
        <exclude domain="database" path="tracker.db-shm" />
    </device-transfer>
</data-extraction-rules>
